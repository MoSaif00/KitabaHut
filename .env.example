# Local development: use Clerk Development keys (pk_test_ / sk_test_).
# Production (Vercel): use Production keys (pk_live_ / sk_live_).
# Production keys will NOT work on http://localhost — they load Clerk JS from your
# production Frontend API domain and fail with failed_to_load_clerk_js.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
CLERK_WEBHOOK_SIGNING_SECRET=

# Required on Vercel production when using a *.vercel.app host (Clerk proxies via /__clerk).
# Example: https://kitabahut.vercel.app/__clerk
# Also set this same proxy URL in Clerk Dashboard → Domains → Frontend API → Set proxy configuration.
NEXT_PUBLIC_CLERK_PROXY_URL=

# Supabase / Prisma
DATABASE_URL=
DIRECT_URL=

# Upload Thing
UPLOADTHING_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
